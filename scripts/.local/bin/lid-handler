#!/usr/bin/env python3
import glob
import os
import struct
import subprocess
import sys
import time

SIZE = struct.calcsize("llHHI")
EV_SW = 0x05
SW_LID = 0x00

os.environ.setdefault("WAYLAND_DISPLAY", "wayland-1")


def find_lid_device():
    for inp in sorted(glob.glob("/sys/class/input/input*")):
        try:
            sw = open(os.path.join(inp, "capabilities", "sw")).read().strip()
            if int(sw, 16) & 0x1:
                events = glob.glob(os.path.join(inp, "event*"))
                if events:
                    return os.path.join("/dev/input", os.path.basename(events[0]))
        except (OSError, ValueError):
            continue
    return None


PROFILE_FILE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "lid-handler-profile"
)
POWER_SAVER = "power-saver"


def run(*args):
    subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def get_profile():
    out = subprocess.run(
        ["powerprofilesctl", "get"], capture_output=True, text=True
    )
    return out.stdout.strip() or None


def set_profile(name):
    run("powerprofilesctl", "set", name)


def save_profile():
    if not os.path.exists(PROFILE_FILE):
        current = get_profile()
        if current:
            open(PROFILE_FILE, "w").write(current)


def restore_profile():
    try:
        previous = open(PROFILE_FILE).read().strip()
        if previous:
            set_profile(previous)
    finally:
        os.path.exists(PROFILE_FILE) and os.remove(PROFILE_FILE)


def on_close():
    save_profile()
    set_profile(POWER_SAVER)
    subprocess.Popen(
        ["hyprlock"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )
    time.sleep(0.5)
    run("hyprctl", "dispatch", 'hl.dsp.dpms({ action = "disable" })')


def on_open():
    restore_profile()
    run("hyprctl", "dispatch", 'hl.dsp.dpms({ action = "enable" })')


def current_lid_state():
    try:
        state = open(glob.glob("/proc/acpi/button/lid/*/state")[0]).read()
        return 1 if state.split()[-1] == "closed" else 0
    except (OSError, IndexError):
        return 0


def main():
    device = find_lid_device()
    if not device:
        sys.stderr.write("lid switch device not found\n")
        return 1

    on_close() if current_lid_state() else on_open()

    fd = os.open(device, os.O_RDONLY)
    while True:
        buf = b""
        while len(buf) < SIZE:
            buf += os.read(fd, SIZE - len(buf))
        _, _, etype, code, value = struct.unpack("llHHI", buf)
        if etype == EV_SW and code == SW_LID:
            on_close() if value else on_open()


if __name__ == "__main__":
    sys.exit(main())
