@import "~/.cache/wal/colors.rasi"

* {
    font: "Rubik 12";

    background-color: transparent;
    text-color: @fg0;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    y-offset: -50;
    x-offset: 20;

    border: 1px;
    border-color: @border-color;
    border-radius: 10px;
    background-color: @bg0;
}

mainbox {
    padding: 12px;
}

inputbar {
    background-color: @bg1;
    border-color: @border-color;

    border: 1px;
    border-radius: 10px;

    padding: 8px 16px;
    spacing: 8px;
}

message {
    margin: 12px 0 0;

    border: 1px;
    border-color: @border-color;
    border-radius: 10px;
    background-color: @bg0;
}

textbox {
    padding: 8px 24px;
}

listview {
    background-color: transparent;
    margin: 12px 0 0;

    fixed-height: false;
}

element {
    border: 1px;
    border-color: transparent;
    border-radius: 8px;
    padding: 8px 12px;
}

element normal active {
    text-color: @accent;
}

element alternate active {
    text-color: @accent;
}

element selected {
    background-color: @bg3;
    border-color: @border-color;
}

element-text {
    text-color: inherit;
}
