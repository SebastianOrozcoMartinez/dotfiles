@import "~/.cache/wal/colors.rasi"

* {
    font: "GoogleSansFlex Nerd Font 12";

    background-color: transparent;
    text-color: @fg0;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    y-offset: -50;
    x-offset: 20;

    border: 0px;
    border-radius: 10px;
    background-color: @bg0;
}

mainbox {
    padding: 12px;
}

inputbar {
    background-color: @bg1;
    border-color: @bg3;

    border: 0px;
    border-radius: 10px;

    padding: 8px 16px;
    spacing: 8px;
}

message {
    margin: 12px 0 0;

    border-radius: 50px;
    border-color: @bg2;
    background-color: @bg2;
}

textbox {
    padding: 8px 24px;
}

listview {
    background-color: transparent;
    margin: 12px 0 0;

    fixed-height: false;
}

element normal active {
    text-color: #DFAB90;
}

element alternate active {
    text-color: #DFAB90;
}

element-text {
    text-color: inherit;
}
